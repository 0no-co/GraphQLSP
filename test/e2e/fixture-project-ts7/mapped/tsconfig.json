{
  "compilerOptions": {
    "plugins": [
      {
        "name": "@0no-co/graphqlsp",
        "schema": "../schema.graphql",
        "tadaOutputLocation": "../src/introspection.d.ts"
      }
    ],
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"],
  "contentMappers": [
    {
      "package": "graphqlsp-test-content-mapper",
      "extensions": [".graphql"]
    }
  ]
}
