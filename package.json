{
  "name": "graphqlsp",
  "version": "0.2.0",
  "private": true,
  "description": "TypeScript LSP plugin that finds GraphQL documents in your code and provides hints and auto-generates types.",
  "main": "./dist/index.js",
  "module": "./dist/index.module.js",
  "scripts": {
    "build": "pnpm --filter @0no-co/graphqlsp build",
    "prepare": "husky",
    "dev": "pnpm --filter @0no-co/graphqlsp dev",
    "launch-debug": "./scripts/launch-debug.sh",
    "test:e2e": "vitest run --no-file-parallelism"
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid",
    "trailingComma": "es5"
  },
  "lint-staged": {
    "*.{js,ts,json,md}": "prettier --write"
  },
  "packageManager": "pnpm@11.3.0",
  "devDependencies": {
    "@0no-co/graphql.web": "^1.3.2",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@babel/plugin-transform-block-scoping": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@changesets/cli": "^3.0.0",
    "@changesets/get-github-info": "^1.0.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.0",
    "dotenv": "^17.4.2",
    "graphql17": "npm:graphql@^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "rollup": "^4.62.2",
    "rollup-plugin-cjs-check": "^1.0.3",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
